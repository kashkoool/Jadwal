# syntax=docker/dockerfile:1.7
# ═══════════════════════════════════════════════════════════════
# Migrations-only image — runs `prisma migrate deploy` against
# whichever DATABASE_URL the runtime env passes in. Used as a
# one-shot ECS Task (NOT a service) — invoked by the deploy
# pipeline before the app rolls out.
#
# Why a separate image instead of reusing apps/api/Dockerfile:
#
# 1. Decoupling. App rollout no longer carries the Prisma CLI
#    inside the runtime image. Smaller (40 MB lighter) and a
#    smaller attack surface (compromised app container can't
#    `npx prisma migrate` arbitrarily).
#
# 2. Explicit failure mode. When this task exits non-zero, the
#    deploy pipeline blocks the app rollout — you see a clean
#    "migration task failed: <Prisma error>" in CloudWatch
#    instead of a generic crash loop on the app side.
#
# 3. Observability. This task gets its own CloudWatch log group
#    so migration runs are independently auditable.
#
# Usage in CI (after AWS lands):
#   aws ecs run-task \
#     --cluster jadwal-prod \
#     --task-definition jadwal-migrations \
#     --launch-type FARGATE \
#     --network-configuration "..." \
#     --wait
#
# Build context MUST be the monorepo root (same as the API image):
#   docker build -f apps/api/Dockerfile.migrations \
#     -t jadwal-migrations:latest .
#
# Local smoke test against the dev DB:
#   docker run --rm \
#     -e DATABASE_URL="postgresql://postgres:admin123@host.docker.internal:5433/jadwal_test" \
#     jadwal-migrations:latest

# ── Stage 1: Pull just the Prisma CLI + its deps ──────────────────
FROM --platform=linux/amd64 node:22-alpine@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f AS deps
WORKDIR /app

# A standalone npm package with `prisma` (the CLI) as its only dep.
# Avoids dragging in the entire api workspace's node_modules — that
# was the whole point of splitting this image out. The pinned version
# MUST match the version in apps/api/package.json devDependencies so
# the engine bundled in the CLI matches the schema. Bump together.
# `overrides` forces patched versions of CVE-affected transitive deps that
# Prisma 7's CLI brings in (hono, @hono/node-server, effect, lodash,
# picomatch). Without these, Trivy flags 5 HIGH CVEs on this image even
# though the migrations container only runs `prisma migrate deploy` and
# never serves traffic. The overrides keep the deploy gate green.
#
# NOTE: this manifest is SYNTHESIZED here and installed with `npm install`,
# NOT `npm ci` against the monorepo lockfile - so the ROOT package.json
# `overrides` do NOT reach this image. Any transitive CVE fixed at the repo
# root must be repeated HERE too, or the Trivy gate fails and deploy/migrate/
# smoke are SKIPPED: the PR merges and production silently never updates.
# That is exactly how mysql2 GHSA-3f6p-5ww8-9rcr blocked the 2026-09-06
# rollout after the root override had already patched it everywhere else.
# Bump these alongside the Prisma version when you upgrade.
RUN echo '{ \
  "name":"jadwal-migrations", \
  "version":"1.0.0", \
  "dependencies":{"prisma":"7.9.1"}, \
  "overrides":{ \
    "hono":"^4.12.4", \
    "@hono/node-server":"^1.19.10", \
    "effect":"^3.20.0", \
    "lodash":"^4.18.1", \
    "picomatch":"^4.0.4", \
    "form-data":"^4.0.6", \
    "mysql2":"^3.22.0", \
    "fast-uri":"^3.1.7", \
    "cross-spawn":"^7.0.6" \
  } \
}' > package.json

RUN --mount=type=cache,target=/root/.npm \
    npm install --omit=dev --ignore-scripts \
 && find node_modules -type f \( \
        -name "*.d.ts" -o -name "*.map" -o \
        -name "LICENSE*" -o -name "CHANGELOG*" -o \
        -name "*.md" -o -name "README*" \
      \) -delete 2>/dev/null \
 && find node_modules -type d \( \
        -name "test" -o -name "tests" -o -name "__tests__" -o \
        -name "docs" -o -name "examples" -o -name ".github" \
      \) -prune -exec rm -rf {} + 2>/dev/null || true

# ── Stage 2: Final image ──────────────────────────────────────────
FROM --platform=linux/amd64 node:22-alpine@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f AS runner
WORKDIR /app

# Patch the base image's OpenSSL (libcrypto3/libssl3): node:22-alpine pins an
# older Alpine whose openssl carries CVE-2026-45447 (HIGH, fixed in 3.5.7-r0),
# which the deploy's Trivy CRITICAL,HIGH gate blocks on. Upgrade just these two.
#
# APK_SECURITY_BUST exists because `--no-cache` above clears APK's package
# INDEX cache, NOT Docker's LAYER cache. The deploy workflow builds with
# `cache-from: type=gha`, and this RUN's cache key never changed — so buildx
# replayed a layer built long before, and the image kept shipping whatever
# openssl was current back then. That is how this line was added for
# CVE-2026-45447 (fixed in 3.5.7-r0) and then CVE-2026-14456 (fixed in
# 3.5.8-r0) silently blocked EVERY deploy on 2026-08-26 while the Dockerfile
# looked correct.
#
# The workflow passes the commit sha, so the upgrade genuinely re-runs on
# every build. Cost: a few seconds and one uncached layer. The alternative is
# rediscovering this by hand the next time an OpenSSL CVE lands.
ARG APK_SECURITY_BUST=dev
RUN echo "apk security upgrade (bust=${APK_SECURITY_BUST})" \
 && apk upgrade --no-cache libcrypto3 libssl3

# Non-root user — same posture as the app image.
RUN addgroup --system --gid 1001 jadwal && \
    adduser --system --uid 1001 jadwal

# Copy the standalone package + Prisma CLI from the deps stage.
# `--chown` pre-ownership means we don't need a separate RUN chown -R
# step (which would create a duplicate full-image layer ~300 MB heavy).
COPY --from=deps --chown=jadwal:jadwal /app/package.json ./
COPY --from=deps --chown=jadwal:jadwal /app/node_modules ./node_modules

# Schema + migration SQL only — no app source, no compiled dist.
# Migration files are deterministic so this layer changes only when
# a new migration is added; ECR push stays small.
COPY --chown=jadwal:jadwal apps/api/prisma ./prisma

# Inline prisma.config.js — wires DATABASE_URL from env into the
# datasource. Prisma 7 requires this file (or schema-level `url`)
# for `migrate deploy` to know where to connect. We use plain JS
# instead of copying the repo's prisma.config.ts to avoid dragging
# in tsx / dotenv just to read one env var.
RUN echo "module.exports = { schema: 'prisma/schema.prisma', migrations: { path: 'prisma/migrations' }, datasource: { url: process.env.DATABASE_URL } };" \
      > prisma.config.js \
 && chown jadwal:jadwal prisma.config.js

# Strip the npm CLI shipped with the node:22-alpine base image — its
# bundled transitive picomatch 4.0.3 trips Trivy with CVE-2026-33671.
# We run prisma directly via node below, so npx isn't needed at runtime.
USER root
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg
USER jadwal

# Direct node invocation of the Prisma CLI, bypassing npm/npx (which we
# just stripped). `prisma migrate deploy` is idempotent — applies any
# pending migrations in order, exits 0 if there's nothing to do, exits
# non-zero on any failure. Exactly what the deploy pipeline wants.
CMD ["node", "/app/node_modules/prisma/build/index.js", "migrate", "deploy"]
