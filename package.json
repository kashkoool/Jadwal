{
  "name": "jadwal-mono",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "db:migrate": "npm run migrate:dev --workspace api",
    "db:studio": "npx prisma studio --schema apps/api/prisma/schema.prisma",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "prepare": "git config core.hooksPath scripts/git-hooks 2>/dev/null || true"
  },
  "devDependencies": {
    "turbo": "2.10.11"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "cross-spawn": "^7.0.6",
    "minimatch": "^9.0.7",
    "lodash": "^4.18.1",
    "postcss": "^8.5.12",
    "@hono/node-server": "^1.19.13",
    "@tootallnate/once": "^3.0.1",
    "fast-uri": "^3.1.7",
    "mysql2": "^3.22.0",
    "qs": "^6.16.0",
    "tmp": "^0.2.5",
    "uuid": "^14.0.0"
  }
}
